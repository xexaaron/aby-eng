{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/aby-eng/include",
                "${workspaceFolder}/aby-eng/include/aby-eng",
                "${workspaceFolder}/vendor/aby-rhi/include",
                "${workspaceFolder}/vendor/aby-rhi/include/aby-rhi",
                "${workspaceFolder}/vendor/aby-rhi/vendor/stb_image/include",
                "${workspaceFolder}/vendor/aby-rhi/vendor/shaderc/libshaderc/include",
                "${workspaceFolder}/vendor/aby-rhi/vendor/vk-bootstrap/src",
                "${workspaceFolder}/vendor/aby-rhi/vendor/vma/include",
                "${workspaceFolder}/vendor/aby-win/aby-win/include",
                "${workspaceFolder}/vendor/aby-win/aby-win/include/aby-win",
                "${workspaceFolder}/vendor/aby-win/vendor/SDL/include",
                "${workspaceFolder}/vendor/aby-win/vendor/glfw/include",
                "${workspaceFolder}/vendor/glm",
                "${env:VULKAN_SDK}/include"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "ABY_BUILD_DLL=1",
                "ABY_WIN_ASSERT=1",
                "ABY_ENG_ENABLE_ASSERT=1"
            ],
            "compilerArgs": [
                "/Zc:preprocessor"
            ],
            "windowsSdkVersion": "10.0.26100.0",
            "compilerPath": "cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "intelliSenseMode": "windows-msvc-x64"
        },
        {
            "name": "Linux-GCC",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "_DEBUG",
                "ABY_BUILD_DLL=1",
                "ABY_WIN_ASSERT=1",
                "ABY_ENG_ENABLE_ASSERT=1"
            ],
            "compilerArgs": [
            ],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "browse": {
                "path": ["${workspaceFolder}"],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            },
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}